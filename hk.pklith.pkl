// generated by `pkli gen` from .pklith; do not edit
import "pkl/Config.pkl"

steps: Mapping<String, Config.Step> = new {
  ["trailing-whitespace"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'trailing-whitespace: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util trailing-whitespace --diff {{files}} || { echo 'trailing-whitespace: trailing blanks; the pre-commit hook strips them' >&2; exit 1; }"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'final-newline: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util end-of-file-fixer --diff {{files}} || { echo 'final-newline: file must end with a newline' >&2; exit 1; }"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'line-endings: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util mixed-line-ending --diff {{files}} || { echo 'line-endings: file mixes CRLF and LF' >&2; exit 1; }"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-bom: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-byte-order-marker {{files}} || { echo 'no-bom: file starts with a byte order marker' >&2; exit 1; }"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-merge-conflict: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-merge-conflict --assume-in-merge {{files}} || { echo 'no-merge-conflict: leftover merge conflict markers' >&2; exit 1; }"
  }
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-case-conflict: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-case-conflict {{files}} || { echo 'no-case-conflict: two paths differ only by case' >&2; exit 1; }"
  }
  ["no-broken-symlinks"] {
    check = "command -v git >/dev/null 2>&1 || { echo 'no-broken-symlinks: git is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v hk >/dev/null 2>&1 || { echo 'no-broken-symlinks: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; git ls-files -z | xargs -0 hk util check-symlinks || { echo 'no-broken-symlinks: a symlink points nowhere' >&2; exit 1; }"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = #"command -v scripts/no-large-files.sh >/dev/null 2>&1 || { echo 'no-large-files: scripts/no-large-files.sh is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; scripts/no-large-files.sh {{files}} || { echo 'no-large-files: file over its type'\''s size limit' >&2; exit 1; }"#
  }
  ["no-private-key"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-private-key: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util detect-private-key {{files}} || { echo 'no-private-key: a private key block is staged' >&2; exit 1; }"
  }
  ["ripsecrets"] {
    glob = List("**/*")
    check = "command -v ripsecrets >/dev/null 2>&1 || { echo 'ripsecrets: ripsecrets is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; ripsecrets {{files}} || { echo 'ripsecrets: a token or credential is staged; a false positive goes in .secretsignore' >&2; exit 1; }"
  }
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "command -v nixfmt >/dev/null 2>&1 || { echo 'nixfmt: nixfmt is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; nixfmt --check {{files}} || { echo 'nixfmt: nix file not formatted' >&2; exit 1; }"
    fix = "nixfmt {{files}}"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    check = "command -v taplo >/dev/null 2>&1 || { echo 'taplo: taplo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; taplo fmt --check {{files}} || { echo 'taplo: TOML not formatted or not parseable' >&2; exit 1; }"
    fix = "taplo fmt {{files}}"
  }
  ["rustfmt"] {
    glob = List("**/*.rs")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'rustfmt: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v cargo-fmt >/dev/null 2>&1 || { echo 'rustfmt: cargo-fmt is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo fmt --check || { echo 'rustfmt: Rust not formatted' >&2; exit 1; }"
    fix = "cargo fmt"
  }
  ["typos"] {
    glob = List("**/*")
    check = "command -v typos >/dev/null 2>&1 || { echo 'typos: typos is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; typos --force-exclude {{files}} || { echo 'typos: misspelling; fix it or teach .typos.toml' >&2; exit 1; }"
  }
  ["shellcheck"] {
    glob = List(".githooks/*", ".envrc", "**/*.sh")
    check = "command -v shellcheck >/dev/null 2>&1 || { echo 'shellcheck: shellcheck is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; shellcheck --shell=bash {{files}} || { echo 'shellcheck: shell script finding' >&2; exit 1; }"
  }
  ["clippy"] {
    glob = List("**/*.rs", "Cargo.toml", "clippy.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'clippy: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v cargo-clippy >/dev/null 2>&1 || { echo 'clippy: cargo-clippy is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo clippy --all-targets -q -- -D warnings || { echo 'clippy: clippy finding or a §C code limit exceeded' >&2; exit 1; }"
  }
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "command -v actionlint >/dev/null 2>&1 || { echo 'actionlint: actionlint is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; actionlint {{files}} || { echo 'actionlint: workflow does not parse or type-check' >&2; exit 1; }"
  }
  ["zizmor"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "command -v zizmor >/dev/null 2>&1 || { echo 'zizmor: zizmor is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; zizmor --offline --no-progress {{files}} || { echo 'zizmor: workflow security finding' >&2; exit 1; }"
  }
  ["rustdoc"] {
    glob = List("**/*.rs", "Cargo.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'rustdoc: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo doc --no-deps --document-private-items -q || { echo 'rustdoc: docs do not build cleanly' >&2; exit 1; }"
    env {
      ["RUSTDOCFLAGS"] = "-D warnings"
    }
  }
  ["links"] {
    glob = List("**/*.md")
    check = "command -v git >/dev/null 2>&1 || { echo 'links: git is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v lychee >/dev/null 2>&1 || { echo 'links: lychee is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; git ls-files -z '*.md' | xargs -0 lychee --offline --no-progress --include-fragments || { echo 'links: a relative link or anchor is broken' >&2; exit 1; }"
  }
  ["mth-fmt"] {
    glob = List("**/SPEC.md")
    check = #"command -v mth >/dev/null 2>&1 || { echo 'mth-fmt: mth is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; for f in {{files}}; do mth fmt --check "$f" || exit 1; done || { echo 'mth-fmt: SPEC.md is hard-wrapped or over the line cap' >&2; exit 1; }"#
    fix = #"for f in {{files}}; do mth fmt "$f" || exit 1; done"#
  }
  ["mth-check"] {
    glob = List("**/SPEC.md")
    check = #"command -v mth >/dev/null 2>&1 || { echo 'mth-check: mth is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; for f in {{files}}; do mth check "$f" || exit 1; done || { echo 'mth-check: SPEC.md breaks a structural rule' >&2; exit 1; }"#
  }
  ["sherd-check"] {
    glob = List("**/SPEC.md", "**/*.rs")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-check: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd check || { echo 'sherd-check: a citation across spec nodes does not resolve' >&2; exit 1; }"
  }
  ["sherd-nav"] {
    glob = List("**/SPEC.md")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-nav: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd sync --check || { echo 'sherd-nav: a §N table is stale' >&2; exit 1; }"
    fix = "sherd sync"
  }
  ["sherd-budget"] {
    glob = List("**/SPEC.md", ".context-limits")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-budget: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd budget || { echo 'sherd-budget: a spec chain is over its ceiling' >&2; exit 1; }"
  }
  ["file-ceilings"] {
    glob = List("**/*.rs")
    check = "command -v scripts/file-ceilings.sh >/dev/null 2>&1 || { echo 'file-ceilings: scripts/file-ceilings.sh is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; scripts/file-ceilings.sh || { echo 'file-ceilings: a Rust file is over its token ceiling' >&2; exit 1; }"
  }
  ["test"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", "src/catalog/builtin.pklith")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'test: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v cargo-nextest >/dev/null 2>&1 || { echo 'test: cargo-nextest is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo nextest run --no-fail-fast --status-level fail --final-status-level fail || { echo 'test: a test failed, or the suite is empty' >&2; exit 1; }"
  }
  ["doctest"] {
    glob = List("**/*.rs", "Cargo.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'doctest: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo test --doc -q || { echo 'doctest: a doc example failed' >&2; exit 1; }"
  }
  ["flake-lock-graph"] {
    glob = List("flake.lock")
    check = "command -v scripts/flake-lock-graph.sh >/dev/null 2>&1 || { echo 'flake-lock-graph: scripts/flake-lock-graph.sh is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; scripts/flake-lock-graph.sh {{files}} || { echo 'flake-lock-graph: flake.lock grew a second nixpkgs or too many nodes' >&2; exit 1; }"
  }
  ["deny"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'deny: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v cargo-deny >/dev/null 2>&1 || { echo 'deny: cargo-deny is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo deny check --disable-fetch licenses bans || { echo 'deny: a license or ban rule failed' >&2; exit 1; }"
  }
  ["catalog-nix"] {
    glob = List("src/catalog/builtin.pklith", "flake.nix", "flake.lock", "scripts/catalog-nix.sh")
    check = "command -v scripts/catalog-nix.sh >/dev/null 2>&1 || { echo 'catalog-nix: scripts/catalog-nix.sh is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; scripts/catalog-nix.sh src/catalog/builtin.pklith || { echo 'catalog-nix: a built-in catalog row names a nix attribute that does not build, or whose binaries its command never calls' >&2; exit 1; }"
  }
  ["gen-check"] {
    glob = List(".pklith", "hk.pklith.pkl")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'gen-check: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo run -q --bin pkli -- gen --check || { echo 'gen-check: a step in hk.pklith.pkl no longer matches .pklith; run `pkli gen`' >&2; exit 1; }"
  }
  ["pkli-check"] {
    check = "command -v cargo >/dev/null 2>&1 || { echo 'pkli-check: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo run -q --bin pkli -- check || { echo 'pkli-check: a tracked file type has no row in .pklith, or a row matches nothing' >&2; exit 1; }"
  }
}

push: Mapping<String, Config.Step> = new {
  ["coverage"] {
    glob = List("**/*.rs", "Cargo.toml", ".coverage")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'coverage: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd coverage --check || { echo 'coverage: line coverage fell below .coverage' >&2; exit 1; }"
  }
}
