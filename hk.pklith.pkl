// generated by `pkli gen` from .pklith; do not edit
import "pkl/Config.pkl"

steps: Mapping<String, Config.Step> = new {
  ["trailing-whitespace"] {
    glob = List("**/*")
    check = "hk util trailing-whitespace --diff {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    check = "hk util end-of-file-fixer --diff {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    check = "hk util mixed-line-ending --diff {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "hk util check-byte-order-marker {{files}}"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "hk util check-case-conflict {{files}}"
  }
  ["no-broken-symlinks"] {
    check = "git ls-files -z | xargs -0 hk util check-symlinks"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "scripts/no-large-files.sh {{files}}"
  }
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["ripsecrets"] {
    glob = List("**/*")
    check = "ripsecrets {{files}}"
  }
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "nixfmt --check {{files}}"
    fix = "nixfmt {{files}}"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    check = "taplo fmt --check {{files}}"
    fix = "taplo fmt {{files}}"
  }
  ["rustfmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["typos"] {
    glob = List("**/*")
    check = "typos --force-exclude {{files}}"
  }
  ["clippy"] {
    glob = List("**/*.rs", "Cargo.toml", "clippy.toml")
    check = "cargo clippy --all-targets -q -- -D warnings"
  }
  ["rustdoc"] {
    glob = List("**/*.rs", "Cargo.toml")
    check = "cargo doc --no-deps --document-private-items -q"
    env {
      ["RUSTDOCFLAGS"] = "-D warnings"
    }
  }
  ["shellcheck"] {
    glob = List(".githooks/*", ".envrc", "**/*.sh")
    check = "shellcheck --shell=bash {{files}}"
  }
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }
  ["zizmor"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "zizmor --offline --no-progress {{files}}"
  }
  ["links"] {
    glob = List("**/*.md")
    check = "git ls-files -z '*.md' | xargs -0 lychee --offline --no-progress --include-fragments"
  }
  ["file-ceilings"] {
    glob = List("**/*.rs")
    check = "scripts/file-ceilings.sh"
  }
  ["mth-fmt"] {
    glob = List("**/SPEC.md")
    check = #"for f in {{files}}; do mth fmt --check "$f" || exit 1; done"#
    fix = #"for f in {{files}}; do mth fmt "$f" || exit 1; done"#
  }
  ["mth-check"] {
    glob = List("**/SPEC.md")
    check = #"for f in {{files}}; do mth check "$f" || exit 1; done"#
  }
  ["sherd-check"] {
    glob = List("**/SPEC.md", "**/*.rs")
    check = "sherd check"
  }
  ["sherd-nav"] {
    glob = List("**/SPEC.md")
    check = "sherd sync --check"
    fix = "sherd sync"
  }
  ["sherd-budget"] {
    glob = List("**/SPEC.md", ".context-limits")
    check = "sherd budget"
  }
  ["pkli-check"] {
    check = "cargo run -q --bin pkli -- check"
  }
  ["gen-check"] {
    glob = List(".pklith", "hk.pklith.pkl")
    check = "cargo run -q --bin pkli -- gen --check"
    fix = "cargo run -q --bin pkli -- gen"
  }
  ["test"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "cargo nextest run --no-fail-fast --status-level fail --final-status-level fail"
  }
  ["doctest"] {
    glob = List("**/*.rs", "Cargo.toml")
    check = "cargo test --doc -q"
  }
  ["coverage"] {
    glob = List("**/*.rs", "Cargo.toml", ".coverage")
    check = "sherd coverage --check"
  }
  ["flake-lock-graph"] {
    glob = List("flake.lock")
    check = "scripts/flake-lock-graph.sh {{files}}"
  }
  ["deny"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check --disable-fetch licenses bans"
  }
}
