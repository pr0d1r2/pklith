/// pklith's gate, defined once. Every step is a plain command a human could
/// paste into a shell; hk decides when steps run (which files, which hook, in
/// what order) and never hides what runs.
///
/// Steps arrive one per commit (pklith V13), each proven against a planted
/// violation first (V2), with the proof in that commit's body (V32).
amends "pkl/Config.pkl"

// The steps pklith materializes from `.pklith` (root T44): `pklith gen` writes
// them to hk.pklith.pkl, and gen-check keeps that file equal to what
// `.pklith` says. Only what belongs to this repository, not to a file type,
// is added here. Plain amends only: hk's own evaluator mishandles filtering
// (B12), and hk-parity fails if it ever sees different steps than pkl (V35).
import "hk.pklith.pkl" as generated

/// The first failure is the most useful thing to show, and steps are ordered
/// cheapest first so it arrives fast.
fail_fast = true

/// Success is silence.
env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// Vendored verbatim: hk's schema and microlith's format documents. An edit
/// would silently fork them, so no fixer touches them (V7).
local vendored = List("pkl/**", "FORMAT.md", "FORMAT-EXTENSIONS.md")

/// Run on every commit: the generated commit steps, plus this repository's own.
local fast = (generated.steps) {
  // T19 (V8): commits land through a branch and pull request, never directly
  // on main. Proven red on main with `hk util no-commit-to-branch --branch main`.
  ["no-commit-to-branch"] {
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-commit-to-branch: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util no-commit-to-branch --branch main || { echo 'no-commit-to-branch: commits to main are refused; work must arrive through a pull request' >&2; exit 1; }"
  }
  ["trailing-whitespace"] { exclude = vendored }
  ["final-newline"] { exclude = vendored }
  ["line-endings"] { exclude = vendored }
  ["ripsecrets"] { exclude = List("pkl/**") }
  // Order. Cargo locks target/, so cargo steps run one after another instead
  // of queueing behind the lock looking hung; a spec file is judged alone
  // before the federation is.
  ["mth-check"] { depends = List("mth-fmt") }
  ["sherd-check"] { depends = List("mth-check") }
  ["sherd-nav"] { depends = List("sherd-check") }
  ["sherd-budget"] { depends = List("sherd-nav") }
  ["file-ceilings"] { depends = List("sherd-check") }
  ["clippy"] { depends = List("rustfmt") }
  ["test"] { depends = List("clippy") }
  ["doctest"] { depends = List("test") }
  ["rustdoc"] { depends = List("clippy") }
  // Every step that runs `cargo run` waits for this build. Started together
  // on a stale binary, one cargo re-links the executable while another is
  // starting it, and macOS kills that process (SIGKILL, exit 137) with no
  // output: a gate step that fails for no reason. Built once first, every
  // later `cargo run` finds it fresh and links nothing.
  ["build"] {
    check = "cargo build -q --workspace --bins"
    depends = List("clippy")
  }
  ["pklith-check"] { depends = List("build") }
  ["gen-check"] { depends = List("build") }
  ["zizmor"] { depends = List("actionlint") }
  // Not file-type checks, so not in .pklith. The AGENTS.md step table is
  // generated from this file and must stay equal to it (V14).
  ["agents-table"] {
    glob = List("hk.pkl", "hk.pklith.pkl", "AGENTS.md", "dev/**")
    check = "cargo run -q -p pklith-dev -- agents --check"
    depends = List("build")
    fix = "cargo run -q -p pklith-dev -- agents"
  }
  // V35 (B12): hk's own Pkl evaluator and `pkl eval` must see the same steps,
  // each with a command. Hand-written, so it does not depend on the
  // generated module it guards.
  // T43 (V6): README badges, and the numbers docs/LLM-DISCLAIMER.md quotes,
  // are rendered by pklith-dev (dev/SPEC.md) from the files that own them.
  ["readme-badges"] {
    glob = List("README.md", "Cargo.toml", ".coverage", "hk.pkl", "hk.pklith.pkl", "flake.lock", "**/SPEC.md", "docs/LLM-DISCLAIMER.md", ".github/workflows/ci.yml", "dev/**")
    check = "cargo run -q -p pklith-dev -- readme --check"
    depends = List("build")
    fix = "cargo run -q -p pklith-dev -- readme"
  }
  // docs/THIRD-PARTY-NOTICES.md: its crate table is what Cargo.lock ships,
  // and its prose holds the counts and the licence claim.
  ["notices"] {
    glob = List("Cargo.toml", "Cargo.lock", "docs/THIRD-PARTY-NOTICES.md", "dev/**")
    check = "cargo run -q -p pklith-dev -- notices --check"
    depends = List("build")
    fix = "cargo run -q -p pklith-dev -- notices"
  }
  // docs/CATALOG.md's tables are the built-in catalog pklith compiles in.
  ["catalog-doc"] {
    glob = List("src/catalog/builtin.pklith", "docs/CATALOG.md", "dev/**")
    check = "cargo run -q -p pklith-dev -- catalog --check"
    depends = List("build")
    fix = "cargo run -q -p pklith-dev -- catalog"
  }
  // docs/CLI.md's usage block is the text pklith prints.
  ["cli-doc"] {
    glob = List("src/cli/mod.rs", "docs/CLI.md", "dev/**")
    check = "cargo run -q -p pklith-dev -- cli --check"
    depends = List("build")
    fix = "cargo run -q -p pklith-dev -- cli"
  }
  // V28 (T65): the vendored schema is the one the pinned hk ships.
  ["schema-pin"] {
    glob = List("pkl/**", "flake.lock", "scripts/schema-pin.sh")
    check = "scripts/schema-pin.sh"
  }
  ["hk-parity"] {
    glob = List("hk.pkl", "hk.pklith.pkl", "pkl/**", "scripts/hk-parity.sh")
    check = "scripts/hk-parity.sh"
  }
}

/// Run on push and in CI: everything in `fast`, plus the generated push steps,
/// the re-lay reproduction (T45), which lays every check into a copy of HEAD
/// through real hooks, and the nix package build (T62): minutes, too slow for
/// each commit.
local all = (fast) {
  ["coverage"] = (generated.push["coverage"]) { depends = List("test") }
  ["relay"] {
    check = "scripts/relay.sh"
    depends = List("gen-check", "pklith-check")
  }
  // T40: no dependency with a published advisory. It fetches the advisory
  // database, so it runs at push, which needs the network anyway; the
  // commit-time `deny` step stays offline. Proven red on a lockfile holding
  // time 0.2.22 (RUSTSEC-2020-0071).
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check advisories"
  }
  // T42: the crate packages, and the packaged crate alone builds; a file
  // the build embeds but the package leaves out fails here, not at
  // publish. Proven red with pkl/ excluded from the package.
  ["package"] {
    glob = List("Cargo.toml", "Cargo.lock", "src/**", "pkl/**")
    check = "cargo package --locked --allow-dirty -q"
  }
  // T41: the public API changes no more than the version says, against the
  // last release tag. Proven red on a narrowed pub fn at 0.1.0.
  ["semver"] {
    glob = List("Cargo.toml", "src/**", "scripts/semver.sh")
    check = "scripts/semver.sh"
  }
  // T64 (V27): pklith timed on 50, 1,000 and 10,000-file fixtures against
  // budgets set from §R R20. Proven red on a budget below the measurement.
  ["bench"] {
    glob = List("Cargo.toml", "Cargo.lock", "src/**", "scripts/bench.sh")
    check = "scripts/bench.sh"
    depends = List("test")
  }
  // T62 (V10): the flake's packages built by nix and run on a fixture, and
  // no placeholder left in what was built.
  ["package-nix"] {
    glob = List("flake.nix", "flake.lock", "Cargo.toml", "Cargo.lock", "src/**", "pkl/**", "nix/**", "scripts/package-nix.sh")
    check = "scripts/package-nix.sh"
    depends = List("test")
  }
}

hooks {
  // `stash = "git"` keeps unstaged edits out of what the steps see, so a
  // commit is judged on what it will contain.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  // Subject `type(scope): claim`, at most 72 characters, and a body that
  // says why (pklith §C, T4). The rules live in pklith-dev (dev/), as tested
  // Rust rather than a string here; the hook passes the file git gave it.
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "cargo run -q -p pklith-dev -- commit-msg {{commit_msg_file}}"
      }
      // V33 (T68): a feat, fix or perf commit changing src/ adds a CHANGELOG
      // entry. Here, not in pre-commit: only the message says which kind a
      // change is.
      ["changelog-touched"] {
        check = "cargo run -q -p pklith-dev -- changelog {{commit_msg_file}}"
        // After commit-msg, never beside it: two `cargo run`s at once can
        // SIGKILL each other on macOS (see the `build` step).
        depends = List("commit-msg")
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  // `hk check`: the entry point for CI and for a full run by hand.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
